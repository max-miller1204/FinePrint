rules_version = '2';

// The API on Cloud Run is the only reader and writer (spec §5.2, §9.2). It
// uses the Admin SDK, which these rules do not apply to. Every request from a
// client SDK, signed in or not, is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
