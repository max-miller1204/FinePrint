{
  "name": "@fineprint/e2e",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build:ios": "xcodebuild -project ../ios/FinePrint.xcodeproj -scheme FinePrint -configuration Debug -destination 'generic/platform=iOS Simulator' -derivedDataPath ../ios/DerivedData CODE_SIGNING_ALLOWED=NO -quiet build",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "test:e2e:web": "E2E_TELEMETRY_DISABLED=1 e2e run --target web",
    "test:e2e:ios": "E2E_TELEMETRY_DISABLED=1 e2e run --target ios"
  },
  "devDependencies": {
    "@ai-sdk/google": "^4.0.104",
    "@e2e-dev/mobile": "0.12.4",
    "@e2e-dev/web": "^0.15.2",
    "agent-device": "0.21.29",
    "ai": "^7.0.151",
    "e2e": "^0.21.3",
    "playwright-core": "1.64.0"
  }
}
