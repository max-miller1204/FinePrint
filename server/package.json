{
  "name": "@fineprint/server",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:emulated": "firebase emulators:exec --only auth,firestore,storage --project demo-fineprint \"tsx watch src/index.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-fineprint",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/emulator/**'",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-fineprint \"vitest run --dir test/emulator\"",
    "smoke:gemma": "tsx scripts/gemma-live.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@hono/node-server": "^2.1.5",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
