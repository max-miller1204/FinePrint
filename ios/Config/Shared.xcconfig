// Base configuration for every build configuration (spec §15.1 step 6, §15.3).
//
// FINEPRINT_SERVER_URL is the server the app talks to when no launch argument
// and no developer-menu value is set. It reaches the app as the
// FinePrintServerURL key in Info.plist (ServerURL.swift reads it).
//
// A xcconfig value cannot hold "//" (it starts a comment), so write it as
// "/$()/": https:/$()/example.run.app.
//
// Debug builds use a server on this Mac.
FINEPRINT_SERVER_URL = http:/$()/localhost:8080

// Release builds (TestFlight, App Store) use the project's deployed server,
// committed in DeployedServer.xcconfig. To use your own server instead, copy
// Server.example.xcconfig to Server.xcconfig and paste the line ./deploy.sh
// prints. That file stays out of git (it names one organization's server) and
// is included last, so it wins.
#include "DeployedServer.xcconfig"
#include? "Server.xcconfig"
